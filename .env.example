# Where Jellyfin answers, as seen from this app (a container name works when both share a network).
LOMBO_FAREWELL_JELLYFIN_URL=http://jellyfin:8096
# Jellyfin: Dashboard > API Keys > +. One key per app, so you can revoke it alone.
LOMBO_FAREWELL_JELLYFIN_API_KEY=changeme
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_FAREWELL_WEBHOOK_URL=
# true = show what would happen and change nothing. Set false only after reading the output of `plan`.
LOMBO_FAREWELL_DRY_RUN=true
# Seconds between rounds when running with --loop. At least 60.
LOMBO_FAREWELL_INTERVAL_SECONDS=3600
# Where the list of titles scheduled for deletion comes from: maintainerr or file.
LOMBO_FAREWELL_SOURCE=maintainerr
# SOURCE=maintainerr: where Maintainerr answers, as seen from this app.
LOMBO_FAREWELL_MAINTAINERR_URL=http://maintainerr:6246
# SOURCE=file: a JSON or plain-text list written by your own cleanup tool or by hand (see docs/setup.md).
LOMBO_FAREWELL_SOURCE_FILE=
# The Jellyfin collection that holds the leaving titles. It is made on the first live run.
LOMBO_FAREWELL_COLLECTION_NAME=Leaving soon
# How many days `lombo-farewell keep` postpones a deletion (1 to 365). Maintainerr source only.
LOMBO_FAREWELL_KEEP_DAYS=30
# The most titles taken out of the collection in one round; the rest wait for the next round.
LOMBO_FAREWELL_MAX_REMOVALS_PER_ROUND=25
# Remembers kept titles and overdue alerts. Keep it in a writable folder (the compose file mounts /data).
LOMBO_FAREWELL_STATE_FILE=/data/state.json
# Safety stop: with true, a round may remove titles even when the wanted list is empty or under half of what
# the collection holds. Leave false; a source that suddenly lists little is more often broken than right.
LOMBO_FAREWELL_ALLOW_SHRINK=false
# By default a collection that this tool did not make is left alone. Set true to let it manage the one
# named by COLLECTION_NAME (it will remove titles that are not leaving).
LOMBO_FAREWELL_ADOPT=false
# `lombo-farewell serve` only: the secret a caller must send as `Authorization: Bearer <token>`. At least 24
# characters, for example the output of `openssl rand -hex 32`. Empty means `serve` refuses to start.
LOMBO_FAREWELL_API_TOKEN=
# `lombo-farewell serve` only: where it listens, as host:port. Keep 127.0.0.1 unless a reverse proxy in another
# container must reach it; then use a private network and never publish the port (docs/security.md).
LOMBO_FAREWELL_API_BIND=127.0.0.1:8098
# Optional command to run once after a keep that really postponed a title (CLI `keep` and POST /v1/keep), for
# example to tell another app. It is started without a shell, with the title as JSON in the environment variable
# LOMBO_FAREWELL_KEPT_JSON ({"id": "<32 hex>", "title": "..."}). A failure is a note on the answer, never a
# failed keep. Never runs in a dry run or when a keep is refused. Empty means none.
LOMBO_FAREWELL_POST_KEEP_COMMAND=
