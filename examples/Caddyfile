# Caddy: expose only the two routes a page needs, under /farewell/, and add the token on the way through.
# The visitor never sees the token and cannot send their own: header_up replaces whatever they sent.
# Put the token in the environment of the Caddy container (LOMBO_FAREWELL_API_TOKEN), never in this file.
# Put this path behind the same login or network limit as the rest of your server (docs/security.md).
jellyfin.example.com {
	handle_path /farewell/* {
		@routes path /v1/leaving /v1/keep
		handle @routes {
			reverse_proxy lombo-farewell:8098 {
				header_up Authorization "Bearer {$LOMBO_FAREWELL_API_TOKEN}"
			}
		}
		respond 404
	}
	# ... the rest of your site (Jellyfin) goes here.
}
